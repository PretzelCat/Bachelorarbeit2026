to start ;Schaltfläche "Start"
  
  update-simulationszeit
  
  ; Beende die Simulation, bevor der zweite Generationswechsel ausgeführt wird 
  if ((jahr = (renteneintritts-alter * 2)) AND (offenes-ende? = false) ) 
  [ 
    if (exportiere-welt? = true) 
    [
      exportiere-welt ("gen2")
      set exportiere-welt? false
    ]
    if (exportiere-interface? = true) 
    [
      exportiere-interface ("gen2") 
      set exportiere-interface? false
    ]
    
    ; Aus irgendeinen Grund ist bei jedem Durchlauf am Ende eine spitze die das 2 bis 3-fache
    ; des Vorjahreswerts beträgt. Das bringt die automatische Skallierung der Graphen durcheinander
    set erledigte-arbeitspakete-pro-jahr 0
    set erledigte-fehler-pro-jahr 0 
    
    ; plots werden durch "tick" geupdatet. Da wir aber am Ende der Simulation
    ; ein "tick" unterschlagen, müssen wir die plots manuell aktuallisieren.
    update-plots
    stop 
  ]
  
  ; Wenn vom Anwender gewünscht, stoppe die Simulation vor dem ersten Generationswechsel
  ; Exportiere anschließend die Welt. D.h. alle Variablen, Agenten, Patches, Interfaces, Regeln, etc. werden gespeichert.
  ; Die .csv Datei kann danach importiert werden. Damit lassen sich alle Szenarien mit den selben Vorbedingungen testen.
  if ((jahr = renteneintritts-alter) AND (ist-monatsanfang? = true) AND (exportiere-welt? = true) ) 
  [
    exportiere-welt ("gen1")
    if (exportiere-interface? = true) [exportiere-interface ("gen1")]
   
    stop 
  ]
  
  ;; Kündige am Monatsanfang Rentner und ersetze sie durch Berufseinsteiger
  if (ist-monatsanfang?)
  [
    update-mitarbeiter-alter
    stelle-ein-und-kündige
  ]
  
  ;; Ändere zum Beginn den Farbton alter Entwickler und setze Variablen für die Graphen zurück
  if (ist-jahresanfang?)
  [
    visualisiere-entwickler-alter 
    set erledigte-arbeitspakete-gesamt (erledigte-arbeitspakete-gesamt + erledigte-arbeitspakete-pro-jahr)
    set erledigte-fehler-gesamt (erledigte-fehler-gesamt + erledigte-fehler-pro-jahr)
    set erledigte-arbeitspakete-pro-jahr 0
    set erledigte-fehler-pro-jahr 0 
  ]
  
  
  ; Wechle zwischen Phase I und II
  (ifelse
    (aktuelle-phase = 1)[phase-I]
    (aktuelle-phase = 2)[phase-II]
    
    ;; Fehlerfall
    [print "Die aktuelle Phase ist weder I noch II"]
  )  
  
  ;; Weise alle Entwickler an, ihre Arbeit zu vollrichten.
  ;; Die Arbeits Reihenfolge der Entwickler wird jeden Tick neu ausgewürfelt
  ask turtles with [ breed != arbeitspakete ] [ arbeit ]
  
  ;; Erhöhe den Simulationstick Counter um 1
  tick 
  
end


