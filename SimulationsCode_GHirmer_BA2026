;; a.1) GLOBALE VARIABLEN -----------------------------------------------
globals [
  
  ;; Monitoring
  tage-gesamt
  tag
  monate-gesamt
  monat
  jahr
  anzahl-phase-II
  erledigte-arbeitspakete-gesamt
  erledigte-fehler-gesamt
  erledigte-arbeitspakete-pro-jahr
  erledigte-fehler-pro-jahr
  durchschnittliche-abhängigkeit ;relevant für Sozialen Einfluss
  
  ;; Phasenrelevant
  fehler-pool
  aktuelle-phase
  fehler-anfang-arbeitsphase
  fehler-gesamt_gemerkt?
  
  ;; Export/Import der Welt und des Interfaces
  speicherort
  
  ;; Ermittlung des ersten Enwicklers der jeweiligen Entwicker Spezies
  erster-entlassen?
  erster-ohne-KI-Entwickler-generiert?
  erster-unreflektierter-KI-Entwickler-generiert?
  erster-reflektierter-KI-Entwickler-generiert?
  
  ;; geheime Flag, um die Zeitspanne der Simulation auf unendlich zu stellen.
  ;; Nur über die Konsole aktivierbar. Wenn "true" dann ist der Endlosmodus
  ;; aktiviert. Nach dem initialisieren anwenden. 
  ;; WICHTIG: Die Graphen vor dem Initialisieren auf "auto scale x-axis" stellen.
  offenes-ende?
]



;; a.2) SPEZIES ---------------------------------------------------------

breed [ohne-KI-entwickler ein-ohne-KI-entwickler] ;; plural singular
ohne-KI-entwickler-own [alter start-monat abhängigkeit kompetenz arbeitspaket-zugewiesen? erster-seiner-art? zugewiesenes-arbeitspaket arbeits-geschwindigkeit fehlerkorrektur-geschwindigkeit]

breed [unreflektierte-KI-entwickler unreflektierter-KI-entwickler]
unreflektierte-KI-entwickler-own [alter start-monat abhängigkeit kompetenz arbeitspaket-zugewiesen? erster-seiner-art? zugewiesenes-arbeitspaket  arbeits-geschwindigkeit fehlerkorrektur-geschwindigkeit]

breed [reflektierte-KI-entwickler reflektierter-KI-entwickler]
reflektierte-KI-entwickler-own [alter start-monat abhängigkeit kompetenz arbeitspaket-zugewiesen? erster-seiner-art? zugewiesenes-arbeitspaket arbeits-geschwindigkeit fehlerkorrektur-geschwindigkeit]

breed [arbeitspakete arbeitspaket]
arbeitspakete-own [arbeitsschritte vergeben? fehlerpaket? fehler]


;; a.3) INITIALISIERUNG DER SIMULATION ----------------------------------

to initialisierung ;Schaltfläche "Initialisierung"
  
  clear-all
  
  generiere-zufalls-seed
  
  set erster-entlassen? (false)
  set erster-ohne-KI-Entwickler-generiert? (false)
  set erster-unreflektierter-KI-Entwickler-generiert? (false)
  set erster-reflektierter-KI-Entwickler-generiert? (false)
  
  set anzahl-phase-II 0
  set erledigte-arbeitspakete-gesamt 0
  set erledigte-fehler-gesamt 0
  set erledigte-arbeitspakete-pro-jahr 0
  set erledigte-fehler-pro-jahr 0
  
  set offenes-ende? false
  
  set aktuelle-phase 1
  erschaffe-arbeitspakete (arbeitspakete-pro-phase-I) (arbeitsschritte-pro-arbeitspaket) (fehler-pro-arbeitspaket)
  
  ;; Merke dir, wie viele Fehler es zu Beginn der Arbeitsphase gibt
  set fehler-anfang-arbeitsphase (sum [fehler] of arbeitspakete)
  
  erschaffe-ohne-KI-entwickler (initiale-entwickler-anzahl)
  
  reset-ticks
  
end


