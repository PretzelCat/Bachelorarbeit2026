;;; Berechnet den Sozialen Einfluss
to-report sozialer-einfluss [ abhängigkeit-agent ]
  
  report Gewichtung_SozialerEinfluss_δ * ( durchschnittliche-abhängigkeit - abhängigkeit-agent )
  
end


;;; Gibt zurück, ob der aktuelle Monat der erste des Jahres ist
to-report ist-monatsanfang?
  
  ifelse ( ticks mod (ticks-per-tag * arbeitstage-pro-monat) = 0)
  [ 
    report (true)
  ][
    report (false)
  ]
end

;;; Gibt zurück, ob heute der erste Tag des Jahres ist
to-report ist-jahresanfang?
  
  ifelse ((monate-gesamt mod (12) = 0) AND (ist-monatsanfang?))
  [ 
    report (true)
  ][
    report (false)
  ]
end

;;; Gibt zurück, ob die Konzeptionsphase noch aktiv ist  
to-report phase-I?
  
  ;; Wenn die Arbeitschritte aller Arbeitspakete erledigt wurden
  if ((count arbeitspakete with [arbeitsschritte != 0]) = 0 ) 
  [
    ; Gib als letztes bescheid, das wir Phase I verlassen haben
    report false
  ]
  
  ; Falls nicht, gib bescheid das wir noch in Phase I sind
  report true
  
end

;;; Gibt zurück, ob die Korrekturphase noch aktiv ist  
to-report phase-II?
  (ifelse 
    ( (sum [fehler] of arbeitspakete = 0) OR (((sum [fehler] of arbeitspakete) / fehler-anfang-arbeitsphase < (fehler-schwellenwert / 100)) ))
    [
      ; Berichte das wir nicht mehr in Phase II sind
      report false
    ]
    [
      ; Berichte, das wir immer noch in Phase II sind
      report true
    ] 
  )
end

